<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.zzih.rudder.dao.mapper.WorkspaceMemberMapper">

    <sql id="baseSql">
        id, workspace_id, user_id, role,
        created_by, created_at, updated_by, updated_at
    </sql>

    <resultMap id="MemberDetailMap" type="io.github.zzih.rudder.dao.entity.view.WorkspaceMemberDetailView"
               autoMapping="true">
        <result column="username" property="username"/>
        <result column="workspace_name" property="workspaceName"/>
    </resultMap>

    <!-- 后端分页 + keyword 后端搜索(用户名);username/workspaceName 由 join 补齐,免 service 内存 enrich。 -->
    <select id="queryDetailPageByWorkspaceId" resultMap="MemberDetailMap">
        select m.id, m.workspace_id, m.user_id, m.role,
               m.created_by, m.created_at, m.updated_by, m.updated_at,
               u.username as username, w.name as workspace_name
        from t_r_workspace_member m
        left join t_r_user u on u.id = m.user_id
        left join t_r_workspace w on w.id = m.workspace_id
        <where>
            m.workspace_id = #{workspaceId}
            <if test="keyword != null and keyword != ''">
                and u.username like concat('%', #{keyword}, '%')
            </if>
        </where>
        order by m.created_at asc
    </select>

    <select id="queryByWorkspaceIdAndUserId" resultType="io.github.zzih.rudder.dao.entity.WorkspaceMember">
        select <include refid="baseSql"/>
        from t_r_workspace_member
        where workspace_id = #{workspaceId}
          and user_id = #{userId}
        limit 1
    </select>

    <select id="queryByWorkspaceId" resultType="io.github.zzih.rudder.dao.entity.WorkspaceMember">
        select <include refid="baseSql"/>
        from t_r_workspace_member
        where workspace_id = #{workspaceId}
    </select>

    <select id="queryByWorkspaceIdAndRole" resultType="io.github.zzih.rudder.dao.entity.WorkspaceMember">
        select <include refid="baseSql"/>
        from t_r_workspace_member
        where workspace_id = #{workspaceId}
          and role = #{role}
    </select>

    <select id="queryByUserId" resultType="io.github.zzih.rudder.dao.entity.WorkspaceMember">
        select <include refid="baseSql"/>
        from t_r_workspace_member
        where user_id = #{userId}
    </select>

</mapper>
